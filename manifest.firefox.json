{
    "manifest_version": 3,
    "name": "ProMT Everything",
    "version": "0.1.0",
    "description": "Adds a button that feeds your whole tab into ProMT.",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://q7x.ru/promt"
    ],
    "action": {
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png"
        }
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
